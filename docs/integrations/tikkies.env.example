# Placeholders only. Copy into server deployment config/secret manager, never frontend.
TIKKIES_API_ENABLED=false
# Required SHA-256 hex of a dedicated random base64url token (plaintext only on Tikkies backend).
TIKKIES_API_KEY_SHA256=<64-character-sha256-hex>
# Optional during rotation; remove after the old credential is retired.
# TIKKIES_API_KEY_PREVIOUS_SHA256=<old-64-character-sha256-hex>
TIKKIES_TRUST_PROXY=false
TIKKIES_RATE_LIMIT_PER_MINUTE=6000
TIKKIES_CUSTOMER_RATE_LIMIT_PER_MINUTE=60

# Existing database/payment settings remain server-only; example placeholders.
DATABASE_URL=postgresql://user:password@localhost:5432/store
STRIPE_SECRET_KEY=<server-stripe-key>
STRIPE_WEBHOOK_SECRET=<endpoint-signing-secret>
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=<sandbox-client-id>
PAYPAL_CLIENT_SECRET=<sandbox-client-secret>
PAYPAL_WEBHOOK_ID=<sandbox-webhook-id>
# Tikkies backend only, never configured as NEXT_PUBLIC_*:
# TIKKIES_STORE_TOKEN=<dedicated-random-token-from-secret-manager>
