generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @db.Uuid
  provider            String    @db.VarChar
  provider_account_id String    @db.VarChar
  access_token        String?
  refresh_token       String?
  expires_at          Int?
  token_type          String?   @db.VarChar
  scope               String?   @db.VarChar
  id_token            String?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_account_id])
  @@index([user_id], map: "idx_accounts_user")
}

model bank_accounts {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_name      String    @db.VarChar
  account_name   String    @db.VarChar
  account_number String    @db.VarChar
  promptpay_no   String?   @db.VarChar
  is_active      Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  qr_code_url    String?
}

model game_keys {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id       String            @db.Uuid
  key_value        String
  status           String            @default("available") @db.VarChar
  order_id         String?           @unique @db.Uuid
  assigned_at      DateTime?         @db.Timestamptz(6)
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  variant_id       String?           @db.Uuid
  orders           orders?           @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction)

  @@index([product_id], map: "idx_keys_product")
  @@index([status], map: "idx_keys_status")
  @@index([variant_id], map: "idx_keys_variant")
}

model gifts {
  id                    Int                   @id @default(autoincrement())
  name                  String                @unique
  image_url             String?
  diamonds              Int                   @default(0)
  is_active             Boolean               @default(true)
  sort_order            Int                   @default(0)
  trigger_type          String?               @db.VarChar
  default_for_functions product_functions[]   @relation("DefaultGift")
  user_function_gifts   user_function_gifts[]
}

model key_access_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  key_id      String?   @db.Uuid
  accessed_at DateTime? @default(now()) @db.Timestamptz(6)
}

model orders {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?               @db.Uuid
  product_id            String                @db.Uuid
  stripe_session_id     String?               @unique @db.VarChar
  stripe_payment_intent String?               @unique @db.VarChar
  // Issuing country of the card used (ISO-3166 alpha-2, e.g. "TH", "US").
  // Drives the Stripe fee tier: domestic 3.65% vs international 4.75% (+2% FX).
  // Null for non-card methods (PromptPay/PayPal) or when Stripe didn't report it.
  card_country          String?               @db.VarChar
  paypal_order_id       String?               @unique @db.VarChar
  paypal_capture_id     String?               @unique @db.VarChar
  amount                Decimal               @db.Decimal(10, 2)
  status                String                @default("pending") @db.VarChar
  paid_at               DateTime?             @db.Timestamptz(6)
  fulfilled_at          DateTime?             @db.Timestamptz(6)
  created_at            DateTime?             @default(now()) @db.Timestamptz(6)
  variant_id            String?               @db.Uuid
  payment_method        String?               @default("stripe") @db.VarChar
  slip_image_url        String?
  slip_verified         Boolean?              @default(false)
  trans_ref             String?               @unique @db.VarChar
  updated_at            DateTime?             @default(now()) @db.Timestamptz(6)
  whitelisted_username  String?               @db.VarChar
  whitelist_status      String?               @default("pending") @db.VarChar
  tiktok_username       String?               @db.VarChar
  activated_device_id   String?
  activated_at          DateTime?
  expires_at            DateTime?
  is_premium_order      Boolean?              @default(false)
  order_type            String                @default("NEW") @db.VarChar
  discount_code_id      String?               @db.Uuid
  discount_amount       Decimal?              @db.Decimal(10, 2)
  // Affiliate referral: the affiliate code from the /r/<code> link the buyer
  // arrived through, stored EVEN when the discount wasn't applied. Lets the
  // affiliate earn commission on their allowed game(s) (the code's product
  // scope) without the customer using the discount. See prepareAffiliateEarning.
  referral_code_id      String?               @db.Uuid
  recorded_by_id        String?               @db.Uuid
  buyer_label           String?               @db.VarChar
  manual_note           String?
  // PayPal.me email-verification flow only. expected_amount is the exact USD
  // total (THB→USD converted at creation + random cents) that the matcher looks
  // for in the incoming PayPal email. Null for every other payment method.
  expected_amount       Decimal?              @db.Decimal(10, 2)
  expected_currency     String?               @default("USD") @db.VarChar
  game_keys             game_keys?
  products              products              @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users?                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recorded_by           users?                @relation("orders_recorded_by", fields: [recorded_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  product_variants      product_variants?     @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discount_code         discount_codes?       @relation("order_discount", fields: [discount_code_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  referral_code         discount_codes?       @relation("order_referral", fields: [referral_code_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  premium_upgrades      premium_upgrades[]
  user_function_gifts   user_function_gifts[]
  discount_redemption   discount_redemptions?
  livegen_config        user_livegen_configs?
  paypal_payment        paypal_payments?
  affiliate_earning     affiliate_earnings?

  @@index([user_id], map: "idx_orders_user")
  @@index([recorded_by_id], map: "idx_orders_recorded_by")
  // Matcher lookup: active paypal_me orders by the exact amount the customer paid.
  @@index([expected_amount, status], map: "idx_orders_expected_amount")
}

model discount_codes {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String                 @unique @db.VarChar
  type           String                 @db.VarChar // "fixed" | "percent"
  value          Decimal                @db.Decimal(10, 2) // 50 (THB) or 10 (%)
  max_uses       Int? // total slots, null = unlimited
  used_count     Int                    @default(0)
  // per-user cap counted against successfully PAID redemptions only. 1 = each user can redeem once.
  // null = unlimited per user.
  per_user_limit Int?                   @default(1)
  min_amount     Decimal?               @db.Decimal(10, 2)
  product_id     String?                @db.Uuid
  starts_at      DateTime?              @db.Timestamptz(6)
  expires_at     DateTime?              @db.Timestamptz(6)
  is_active      Boolean                @default(true)
  // Public/featured code (TikTok/Shopee-style): shown as a clickable card under
  // the discount input in the product modal for EVERYONE. Visibility only —
  // redemption rules (max_uses/per_user_limit/…) are identical to normal codes.
  is_public      Boolean                @default(false)
  // Auto-select: this code is pre-applied when a shopper opens the product
  // modal, and drives the strikethrough preview price on the shop card. Only
  // takes effect while is_public is also true (must be visible to be applied).
  // Multiple codes may be flagged; per product the biggest-discount one wins.
  is_auto_select Boolean                @default(false)
  // Affiliate code: when set, this code belongs to an affiliate (a user with
  // role=affiliate). A paid order carrying it credits the owner a commission
  // (see affiliate_earnings). Affiliate codes are NOT is_public — they auto-
  // apply only when the shopper arrives via the affiliate's /r/<code> link.
  owner_user_id  String?                @db.Uuid
  // Per-code commission override (%). null = use the owner's
  // affiliate_profiles.default_commission_pct. Only meaningful when owner set.
  commission_pct Decimal?               @db.Decimal(5, 2)
  note           String?                @db.VarChar
  created_at     DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?              @default(now()) @db.Timestamptz(6)
  product        products?              @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  owner          users?                 @relation("affiliate_codes", fields: [owner_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  redemptions    discount_redemptions[]
  orders         orders[]             @relation("order_discount")
  referred_orders orders[]            @relation("order_referral")
  affiliate_earnings affiliate_earnings[]

  @@index([code], map: "idx_discount_codes_code")
  @@index([is_active, expires_at], map: "idx_discount_codes_active")
  @@index([owner_user_id], map: "idx_discount_codes_owner")
}

model discount_redemptions {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discount_code_id String         @db.Uuid
  order_id         String         @unique @db.Uuid
  user_id          String         @db.Uuid
  amount_off       Decimal        @db.Decimal(10, 2)
  redeemed_at      DateTime       @default(now()) @db.Timestamptz(6)
  discount_codes   discount_codes @relation(fields: [discount_code_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders           orders         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([discount_code_id], map: "idx_redemptions_code")
  @@index([user_id], map: "idx_redemptions_user")
}

// ─────────────────────────────────────────────────────────────────────────────
// Affiliate program. An affiliate is a `users` row with role=affiliate that
// owns one or more discount_codes. When a paid order carries an owned code, the
// owner earns a commission — frozen into affiliate_earnings at fulfillment time
// so history never shifts when rates change. Attribution is code-based (the
// /r/<code> link just auto-applies the code; credit follows the code on the
// paid order). See lib/orderFulfillment.ts for the capture point.
// ─────────────────────────────────────────────────────────────────────────────

// One row per affiliate user: their default commission rate + payout details.
// Created by admin when granting the affiliate role.
model affiliate_profiles {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @unique @db.Uuid
  default_commission_pct Decimal  @default(0) @db.Decimal(5, 2)
  payout_method         String?   @db.VarChar // channel: promptpay | bank_th | paypal | wise | bank_intl | other
  // Structured per-channel fields (email, account no, SWIFT, country, …) so the
  // affiliate fills it once and can edit later without re-typing. See lib/affiliatePayout.ts.
  payout_info           Json?
  payout_detail         String?   @db.VarChar // computed one-line summary (for admin display + payout snapshot)
  display_name          String?   @db.VarChar // optional public-facing name
  is_active             Boolean   @default(true)
  // Public read-only API for the affiliate's own data (they build their own
  // dashboard). Admin gates access with api_enabled; only the SHA-256 hash of
  // the key is stored — the plaintext is shown once at generation. api_key_prefix
  // is a short non-secret label (e.g. "afk_ab12cd34") for the UI.
  api_enabled           Boolean   @default(false)
  api_key_hash          String?   @db.VarChar
  api_key_prefix        String?   @db.VarChar
  api_key_created_at    DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user                  users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// Immutable commission ledger. One row per credited order (order_id UNIQUE =
// never double-credit). base_amount/commission_pct/commission_amount are FROZEN
// at creation — later rate edits never touch past earnings. status lifecycle:
//   pending → paid   (admin settles, links a payout)
//   pending → reversed / paid → reversed (order later cancelled; clawback flags
//                                          a reversal of money already paid out)
model affiliate_earnings {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_user_id String    @db.Uuid
  order_id          String    @unique @db.Uuid
  discount_code_id  String?   @db.Uuid
  base_amount       Decimal   @db.Decimal(10, 2) // product revenue: subtotal after discount, ex-fee
  commission_pct    Decimal   @db.Decimal(5, 2)  // rate actually applied (frozen)
  commission_amount Decimal   @db.Decimal(10, 2) // base_amount * commission_pct / 100 (frozen)
  status            String    @default("pending") @db.VarChar // pending | paid | reversed
  clawback          Boolean   @default(false) // true when a PAID earning was reversed → admin must recover
  payout_id         String?   @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  paid_at           DateTime? @db.Timestamptz(6)
  reversed_at       DateTime? @db.Timestamptz(6)
  affiliate         users          @relation(fields: [affiliate_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order             orders         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  discount_code     discount_codes? @relation(fields: [discount_code_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payout            affiliate_payouts? @relation(fields: [payout_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([affiliate_user_id, status], map: "idx_aff_earnings_user_status")
  @@index([payout_id], map: "idx_aff_earnings_payout")
  @@index([created_at], map: "idx_aff_earnings_created")
}

// One withdrawal record. Doubles as the affiliate-initiated REQUEST and the
// admin PAYOUT: status walks requested → paid (admin transferred) or
// requested → rejected (amount returned to the affiliate's pending balance).
// Admin can also create one directly as status=paid (no request). The earnings
// it covers point back via payout_id, so "what did this ฿X cover?" is always
// answerable. method/detail snapshot the affiliate's payout info at request
// time so admin knows where to send even if the affiliate edits it later.
model affiliate_payouts {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_user_id String    @db.Uuid
  amount            Decimal   @db.Decimal(10, 2)
  status            String    @default("paid") @db.VarChar // requested | paid | rejected | cancelled
  method            String?   @db.VarChar // payout channel snapshot
  detail            String?   @db.VarChar // account / promptpay snapshot
  note              String?   @db.VarChar
  reject_reason     String?   @db.VarChar // admin's reason when status=rejected (shown to affiliate)
  requested_at      DateTime? @db.Timestamptz(6)
  paid_at           DateTime? @db.Timestamptz(6) // set when status becomes paid
  created_by_id     String?   @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  affiliate         users     @relation(fields: [affiliate_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  earnings          affiliate_earnings[]

  @@index([affiliate_user_id], map: "idx_aff_payouts_user")
  @@index([status], map: "idx_aff_payouts_status")
}

model product_functions {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id                String                @db.Uuid
  name                      String                @db.VarChar
  label_th                  String?               @db.VarChar
  label_en                  String?               @db.VarChar
  image_url                 String?
  sort_order                Int                   @default(0)
  default_gift_id           Int?
  created_at                DateTime?             @default(now()) @db.Timestamptz(6)
  default_trigger_threshold Int?
  default_gift              gifts?                @relation("DefaultGift", fields: [default_gift_id], references: [id])
  products                  products              @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_function_gifts       user_function_gifts[]

  @@index([product_id], map: "idx_product_functions_product")
}

model product_gifts {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String    @db.Uuid
  url        String
  filename   String?   @db.VarChar
  sort_order Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_gifts_product")
}

model product_images {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String    @db.Uuid
  url        String
  sort_order Int?      @default(0)
  alt_text   String?   @db.VarChar
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_images_product")
}

// Multiple YouTube video URLs per product (shown on the product page). The
// legacy single `products.youtube_url` is kept in sync with the first video so
// the shop ProductModal keeps working unchanged.
model product_videos {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  url        String
  sort_order Int?     @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_videos_product")
}

model product_presets {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String    @db.Uuid
  url        String
  filename   String    @db.VarChar
  filesize   Int?
  sort_order Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_presets_product")
}

model product_variants {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id          String    @db.Uuid
  duration_type       String    @db.VarChar
  duration_days       Int?
  label_th            String    @db.VarChar
  label_en            String    @db.VarChar
  price               Decimal   @db.Decimal(10, 2)
  is_active           Boolean?  @default(true)
  sort_order          Int?      @default(0)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  variant_type        String?   @default("normal") @db.VarChar
  premium_addon_price Decimal?  @default(0) @db.Decimal(10, 2)

  // New Discount Fields
  discount_pct   Decimal? @default(0) @db.Decimal(5, 2)
  discount_limit Int?     @default(0)
  discount_used  Int?     @default(0)

  game_keys game_keys[]
  orders    orders[]
  products  products    @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_variants_product")
}

model products {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String   @unique @db.VarChar
  name_th        String   @db.VarChar
  name_en        String   @db.VarChar
  description_th String?
  description_en String?
  price          Decimal  @db.Decimal(10, 2)
  is_active      Boolean? @default(true)
  is_featured    Boolean? @default(false)

  // New Discount Toggle
  has_limited_discount Boolean? @default(false)

  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  isLower               Boolean?                @default(false)
  owner_name            String?                 @db.VarChar
  owner_contact         String?                 @db.VarChar
  commission_pct        Decimal?                @default(0) @db.Decimal(5, 2)
  is_consignment        Boolean?                @default(false)
  info_page_url         String?
  discord_role_id       String?                 @db.VarChar
  discord_guild_id      String?                 @db.VarChar
  youtube_url           String?
  tutorial_video_url    String?
  preview_video_url     String?
  created_by_id         String?                 @db.Uuid
  game_keys             game_keys[]
  orders                orders[]
  premium_upgrades      premium_upgrades[]
  product_consignments  product_consignments[]
  product_functions     product_functions[]
  product_gifts         product_gifts[]
  product_images        product_images[]
  product_videos        product_videos[]
  product_presets       product_presets[]
  product_shares        product_shares[]
  product_variants      product_variants[]
  discount_codes        discount_codes[]
  created_by            users?                  @relation("ProductCreator", fields: [created_by_id], references: [id])
  user_whitelist_access user_whitelist_access[]
  user_livegen_drafts   user_livegen_drafts[]

  @@index([is_consignment], map: "idx_products_consignment")
  @@index([created_by_id], map: "idx_products_creator")
}

model partners {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @db.VarChar
  contact        String?          @db.VarChar
  bank_name      String?          @db.VarChar
  account_number String?          @db.VarChar
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @default(now()) @db.Timestamptz(6)
  product_shares product_shares[]
}

model product_shares {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String    @db.Uuid
  partner_id String    @db.Uuid
  share_pct  Decimal   @db.Decimal(5, 2)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  partners   partners  @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@index([partner_id])
}

model product_consignments {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id    String    @db.Uuid
  owner_name    String    @db.VarChar
  owner_contact String?   @db.VarChar
  payout_share  Decimal   @db.Decimal(5, 2)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  products      products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id], map: "idx_pc_product")
}

model user_whitelist_access {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ign        String   @db.VarChar
  product_id String   @db.Uuid
  is_premium Boolean  @default(false)
  expires_at DateTime @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([ign, product_id])
  @@index([ign], map: "idx_uwa_ign")
}

model premium_upgrades {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String   @db.Uuid
  user_id           String   @db.Uuid
  product_id        String   @db.Uuid
  amount            Decimal  @db.Decimal(10, 2)
  payment_method    String   @db.VarChar
  stripe_session_id String?  @db.VarChar
  upgraded_at       DateTime @default(now()) @db.Timestamptz(6)
  status            String   @default("paid") @db.VarChar
  orders            orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
