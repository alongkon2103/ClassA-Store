generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @db.Uuid
  provider            String    @db.VarChar
  provider_account_id String    @db.VarChar
  access_token        String?
  refresh_token       String?
  expires_at          Int?
  token_type          String?   @db.VarChar
  scope               String?   @db.VarChar
  id_token            String?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_account_id])
  @@index([user_id], map: "idx_accounts_user")
}

model bank_accounts {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_name      String    @db.VarChar
  account_name   String    @db.VarChar
  account_number String    @db.VarChar
  promptpay_no   String?   @db.VarChar
  is_active      Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  qr_code_url    String?
}

model game_keys {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id       String            @db.Uuid
  key_value        String
  status           String            @default("available") @db.VarChar
  order_id         String?           @unique @db.Uuid
  assigned_at      DateTime?         @db.Timestamptz(6)
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  variant_id       String?           @db.Uuid
  orders           orders?           @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction)

  @@index([product_id], map: "idx_keys_product")
  @@index([status], map: "idx_keys_status")
  @@index([variant_id], map: "idx_keys_variant")
}

model gifts {
  id                    Int                   @id @default(autoincrement())
  name                  String                @unique
  image_url             String?
  diamonds              Int                   @default(0)
  is_active             Boolean               @default(true)
  sort_order            Int                   @default(0)
  trigger_type          String?               @db.VarChar
  default_for_functions product_functions[]   @relation("DefaultGift")
  user_function_gifts   user_function_gifts[]
}

model key_access_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  key_id      String?   @db.Uuid
  accessed_at DateTime? @default(now()) @db.Timestamptz(6)
}

model orders {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?               @db.Uuid
  product_id            String                @db.Uuid
  stripe_session_id     String?               @unique @db.VarChar
  stripe_payment_intent String?               @unique @db.VarChar
  paypal_order_id       String?               @unique @db.VarChar
  paypal_capture_id     String?               @unique @db.VarChar
  amount                Decimal               @db.Decimal(10, 2)
  status                String                @default("pending") @db.VarChar
  paid_at               DateTime?             @db.Timestamptz(6)
  fulfilled_at          DateTime?             @db.Timestamptz(6)
  created_at            DateTime?             @default(now()) @db.Timestamptz(6)
  variant_id            String?               @db.Uuid
  payment_method        String?               @default("stripe") @db.VarChar
  slip_image_url        String?
  slip_verified         Boolean?              @default(false)
  trans_ref             String?               @unique @db.VarChar
  updated_at            DateTime?             @default(now()) @db.Timestamptz(6)
  whitelisted_username  String?               @db.VarChar
  whitelist_status      String?               @default("pending") @db.VarChar
  tiktok_username       String?               @db.VarChar
  activated_device_id   String?
  activated_at          DateTime?
  expires_at            DateTime?
  is_premium_order      Boolean?              @default(false)
  order_type            String                @default("NEW") @db.VarChar
  discount_code_id      String?               @db.Uuid
  discount_amount       Decimal?              @db.Decimal(10, 2)
  recorded_by_id        String?               @db.Uuid
  buyer_label           String?               @db.VarChar
  manual_note           String?
  // PayPal.me email-verification flow only. expected_amount is the exact USD
  // total (THB→USD converted at creation + random cents) that the matcher looks
  // for in the incoming PayPal email. Null for every other payment method.
  expected_amount       Decimal?              @db.Decimal(10, 2)
  expected_currency     String?               @default("USD") @db.VarChar
  game_keys             game_keys?
  products              products              @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users?                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recorded_by           users?                @relation("orders_recorded_by", fields: [recorded_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  product_variants      product_variants?     @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discount_code         discount_codes?       @relation(fields: [discount_code_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  premium_upgrades      premium_upgrades[]
  user_function_gifts   user_function_gifts[]
  discount_redemption   discount_redemptions?
  livegen_config        user_livegen_configs?
  paypal_payment        paypal_payments?

  @@index([user_id], map: "idx_orders_user")
  @@index([recorded_by_id], map: "idx_orders_recorded_by")
  // Matcher lookup: active paypal_me orders by the exact amount the customer paid.
  @@index([expected_amount, status], map: "idx_orders_expected_amount")
}

model discount_codes {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String                 @unique @db.VarChar
  type           String                 @db.VarChar // "fixed" | "percent"
  value          Decimal                @db.Decimal(10, 2) // 50 (THB) or 10 (%)
  max_uses       Int? // total slots, null = unlimited
  used_count     Int                    @default(0)
  // per-user cap counted against successfully PAID redemptions only. 1 = each user can redeem once.
  // null = unlimited per user.
  per_user_limit Int?                   @default(1)
  min_amount     Decimal?               @db.Decimal(10, 2)
  product_id     String?                @db.Uuid
  starts_at      DateTime?              @db.Timestamptz(6)
  expires_at     DateTime?              @db.Timestamptz(6)
  is_active      Boolean                @default(true)
  note           String?                @db.VarChar
  created_at     DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?              @default(now()) @db.Timestamptz(6)
  product        products?              @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  redemptions    discount_redemptions[]
  orders         orders[]

  @@index([code], map: "idx_discount_codes_code")
  @@index([is_active, expires_at], map: "idx_discount_codes_active")
}

model discount_redemptions {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discount_code_id String         @db.Uuid
  order_id         String         @unique @db.Uuid
  user_id          String         @db.Uuid
  amount_off       Decimal        @db.Decimal(10, 2)
  redeemed_at      DateTime       @default(now()) @db.Timestamptz(6)
  discount_codes   discount_codes @relation(fields: [discount_code_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders           orders         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([discount_code_id], map: "idx_redemptions_code")
  @@index([user_id], map: "idx_redemptions_user")
}

model product_functions {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id                String                @db.Uuid
  name                      String                @db.VarChar
  label_th                  String?               @db.VarChar
  label_en                  String?               @db.VarChar
  image_url                 String?
  sort_order                Int                   @default(0)
  default_gift_id           Int?
  created_at                DateTime?             @default(now()) @db.Timestamptz(6)
  default_trigger_threshold Int?
  default_gift              gifts?                @relation("DefaultGift", fields: [default_gift_id], references: [id])
  products                  products              @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_function_gifts       user_function_gifts[]

  @@index([product_id], map: "idx_product_functions_product")
}

model product_gifts {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String    @db.Uuid
  url        String
  filename   String?   @db.VarChar
  sort_order Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_gifts_product")
}

model product_images {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String    @db.Uuid
  url        String
  sort_order Int?      @default(0)
  alt_text   String?   @db.VarChar
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_images_product")
}

model product_presets {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String    @db.Uuid
  url        String
  filename   String    @db.VarChar
  filesize   Int?
  sort_order Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_presets_product")
}

model product_variants {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id          String    @db.Uuid
  duration_type       String    @db.VarChar
  duration_days       Int?
  label_th            String    @db.VarChar
  label_en            String    @db.VarChar
  price               Decimal   @db.Decimal(10, 2)
  is_active           Boolean?  @default(true)
  sort_order          Int?      @default(0)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  variant_type        String?   @default("normal") @db.VarChar
  premium_addon_price Decimal?  @default(0) @db.Decimal(10, 2)

  // New Discount Fields
  discount_pct   Decimal? @default(0) @db.Decimal(5, 2)
  discount_limit Int?     @default(0)
  discount_used  Int?     @default(0)

  game_keys game_keys[]
  orders    orders[]
  products  products    @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_variants_product")
}

model products {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String   @unique @db.VarChar
  name_th        String   @db.VarChar
  name_en        String   @db.VarChar
  description_th String?
  description_en String?
  price          Decimal  @db.Decimal(10, 2)
  is_active      Boolean? @default(true)
  is_featured    Boolean? @default(false)

  // New Discount Toggle
  has_limited_discount Boolean? @default(false)

  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  isLower               Boolean?                @default(false)
  owner_name            String?                 @db.VarChar
  owner_contact         String?                 @db.VarChar
  commission_pct        Decimal?                @default(0) @db.Decimal(5, 2)
  is_consignment        Boolean?                @default(false)
  info_page_url         String?
  discord_role_id       String?                 @db.VarChar
  discord_guild_id      String?                 @db.VarChar
  youtube_url           String?
  tutorial_video_url    String?
  preview_video_url     String?
  created_by_id         String?                 @db.Uuid
  game_keys             game_keys[]
  orders                orders[]
  premium_upgrades      premium_upgrades[]
  product_consignments  product_consignments[]
  product_functions     product_functions[]
  product_gifts         product_gifts[]
  product_images        product_images[]
  product_presets       product_presets[]
  product_shares        product_shares[]
  product_variants      product_variants[]
  discount_codes        discount_codes[]
  created_by            users?                  @relation("ProductCreator", fields: [created_by_id], references: [id])
  user_whitelist_access user_whitelist_access[]
  user_livegen_drafts   user_livegen_drafts[]

  @@index([is_consignment], map: "idx_products_consignment")
  @@index([created_by_id], map: "idx_products_creator")
}

model partners {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @db.VarChar
  contact        String?          @db.VarChar
  bank_name      String?          @db.VarChar
  account_number String?          @db.VarChar
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @default(now()) @db.Timestamptz(6)
  product_shares product_shares[]
}

model product_shares {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String    @db.Uuid
  partner_id String    @db.Uuid
  share_pct  Decimal   @db.Decimal(5, 2)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  partners   partners  @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@index([partner_id])
}

model product_consignments {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id    String    @db.Uuid
  owner_name    String    @db.VarChar
  owner_contact String?   @db.VarChar
  payout_share  Decimal   @db.Decimal(5, 2)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  products      products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id], map: "idx_pc_product")
}

model user_whitelist_access {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ign        String   @db.VarChar
  product_id String   @db.Uuid
  is_premium Boolean  @default(false)
  expires_at DateTime @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([ign, product_id])
  @@index([ign], map: "idx_uwa_ign")
}

model premium_upgrades {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String   @db.Uuid
  user_id           String   @db.Uuid
  product_id        String   @db.Uuid
  amount            Decimal  @db.Decimal(10, 2)
  payment_method    String   @db.VarChar
  stripe_session_id String?  @db.VarChar
  upgraded_at       DateTime @default(now()) @db.Timestamptz(6)
  status            String   @default("paid") @db.VarChar
  orders            orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  products          products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  users             users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_pu_user")
  @@index([product_id], map: "idx_pu_product")
  @@index([upgraded_at], map: "idx_pu_date")
}

model user_function_gifts {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String            @db.Uuid
  order_id          String            @db.Uuid
  function_id       String            @db.Uuid
  gift_id           Int
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  trigger_threshold Int?
  is_enabled        Boolean           @default(true)
  product_functions product_functions @relation(fields: [function_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gifts             gifts             @relation(fields: [gift_id], references: [id], onUpdate: NoAction)
  orders            orders            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_ufg_order")
  @@index([user_id], map: "idx_ufg_user")
  @@index([function_id], map: "idx_ufg_function")
  @@index([gift_id], map: "idx_ufg_gift")
}

model user_livegen_configs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  order_id   String   @unique @db.Uuid
  config     Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  orders     orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_livegen_user")
}

// Public-mode drafts — one config per (user, product). Separate from
// user_livegen_configs (which is keyed by order) so users without an order can
// still save, and so order-based configs and public drafts never overwrite
// each other.
model user_livegen_drafts {
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  config     Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, product_id])
  @@index([product_id], map: "idx_livegen_drafts_product")
}

model users {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username             String                 @db.VarChar
  email                String?                @unique @db.VarChar
  role                 Role                   @default(user)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  avatar               String?                @db.VarChar
  hwid                 String?                @unique @db.VarChar
  lastSeen             DateTime?              @db.Timestamptz(6)
  nativeStatus         String                 @default("ACTIVE") @db.VarChar
  nativeExpiry         DateTime?              @db.Timestamptz(6)
  isOnlineDesktop      Boolean                @default(false)
  accounts             accounts[]
  announcements        announcements[]
  games                games[]
  orders               orders[]
  recorded_orders      orders[]               @relation("orders_recorded_by")
  premium_upgrades     premium_upgrades[]
  presets              presets[]
  created_products     products[]             @relation("ProductCreator")
  user_function_gifts  user_function_gifts[]
  user_livegen_configs user_livegen_configs[]
  user_livegen_drafts  user_livegen_drafts[]
  user_presets         user_presets[]
}

model system_configs {
  key   String @id
  value String
}

model announcements {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   @db.VarChar
  content     String
  isActive    Boolean  @default(true)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @db.Timestamptz(6)
  imageUrl    String?  @db.VarChar
  users       users?   @relation(fields: [createdById], references: [id])
}

model app_rules {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  presetId  String     @db.Uuid
  event     RuleEvent
  condition Json?
  action    RuleAction
  key       String?    @db.VarChar
  sound     String?    @db.VarChar
  volume    Float?     @default(1.0)
  duration  String?    @db.VarChar
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @db.Timestamptz(6)
  presets   presets    @relation(fields: [presetId], references: [id], onDelete: Cascade)
}

model games {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique @db.VarChar
  description String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @db.Timestamptz(6)
  users       users?    @relation(fields: [createdById], references: [id])
  presets     presets[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model gifts_backup_20260524 {
  id           Int?
  name         String?
  image_url    String?
  diamonds     Int?
  is_active    Boolean?
  sort_order   Int?
  trigger_type String?  @db.VarChar

  @@ignore
}

model presets {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String         @db.VarChar
  description  String?
  isDefault    Boolean        @default(false)
  gameId       String         @db.Uuid
  createdById  String?        @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @db.Timestamptz(6)
  app_rules    app_rules[]
  users        users?         @relation(fields: [createdById], references: [id])
  games        games          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user_presets user_presets[]

  @@unique([createdById, gameId, name])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model product_functions_backup_20260524 {
  id                        String?   @db.Uuid
  product_id                String?   @db.Uuid
  name                      String?   @db.VarChar
  label_th                  String?   @db.VarChar
  label_en                  String?   @db.VarChar
  image_url                 String?
  sort_order                Int?
  default_gift_id           Int?
  created_at                DateTime? @db.Timestamptz(6)
  default_trigger_threshold Int?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model user_function_gifts_backup_20260524 {
  id                String?   @db.Uuid
  user_id           String?   @db.Uuid
  order_id          String?   @db.Uuid
  function_id       String?   @db.Uuid
  gift_id           Int?
  updated_at        DateTime? @db.Timestamptz(6)
  trigger_threshold Int?

  @@ignore
}

model user_presets {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  presetId       String   @db.Uuid
  isActive       Boolean  @default(false)
  sourcePresetId String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  presets        presets  @relation(fields: [presetId], references: [id], onDelete: Cascade)
  users          users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, presetId])
}

model page_views {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitor_id String   @db.VarChar(64)
  user_id    String?  @db.Uuid
  path       String   @db.VarChar(512)
  referrer   String?  @db.VarChar(512)
  country    String?  @db.VarChar(8)
  device     String?  @db.VarChar(16)
  locale     String?  @db.VarChar(8)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([visitor_id, path, created_at])
  @@index([path, created_at])
}

