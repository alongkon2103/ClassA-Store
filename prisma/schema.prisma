generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @db.Uuid
  provider            String    @db.VarChar
  provider_account_id String    @db.VarChar
  access_token        String?
  refresh_token       String?
  expires_at          Int?
  token_type          String?   @db.VarChar
  scope               String?   @db.VarChar
  id_token            String?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_account_id])
  @@index([user_id], map: "idx_accounts_user")
}

model bank_accounts {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_name      String    @db.VarChar
  account_name   String    @db.VarChar
  account_number String    @db.VarChar
  promptpay_no   String?   @db.VarChar
  is_active      Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  qr_code_url    String?
}

model game_keys {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id       String            @db.Uuid
  key_value        String
  status           String            @default("available") @db.VarChar
  order_id         String?           @unique @db.Uuid
  assigned_at      DateTime?         @db.Timestamptz(6)
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  variant_id       String?           @db.Uuid
  orders           orders?           @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction)

  @@index([product_id], map: "idx_keys_product")
  @@index([status], map: "idx_keys_status")
  @@index([variant_id], map: "idx_keys_variant")
}

model gifts {
  id                    Int                   @id @default(autoincrement())
  name                  String                @unique
  image_url             String?
  diamonds              Int                   @default(0)
  is_active             Boolean               @default(true)
  sort_order            Int                   @default(0)
  user_function_gifts   user_function_gifts[]
  default_for_functions product_functions[]   @relation("DefaultGift")
}

model key_access_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  key_id      String?   @db.Uuid
  accessed_at DateTime? @default(now()) @db.Timestamptz(6)
}

model orders {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @db.Uuid
  product_id            String    @db.Uuid
  stripe_session_id     String?   @unique @db.VarChar
  stripe_payment_intent String?   @unique @db.VarChar
  amount                Decimal   @db.Decimal(10, 2)
  status                String    @default("pending") @db.VarChar
  paid_at               DateTime? @db.Timestamptz(6)
  fulfilled_at          DateTime? @db.Timestamptz(6)
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  variant_id            String?   @db.Uuid
  payment_method        String?   @default("stripe") @db.VarChar
  slip_image_url        String?
  slip_verified         Boolean?  @default(false)
  trans_ref             String?   @unique @db.VarChar
  updated_at            DateTime? @default(now()) @db.Timestamptz(6)
  whitelisted_username  String?   @db.VarChar
  whitelist_status      String?   @default("pending") @db.VarChar
  tiktok_username       String?   @db.VarChar
  activated_device_id   String?
  activated_at          DateTime?
  expires_at            DateTime?
  is_premium_order      Boolean?  @default(false)
  order_type            String    @default("NEW") @db.VarChar

  game_keys           game_keys?
  products            products              @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants    product_variants?     @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_function_gifts user_function_gifts[]
  premium_upgrades    premium_upgrades[]

  @@index([user_id], map: "idx_orders_user")
}

model product_functions {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id          String                @db.Uuid
  name                String                @db.VarChar
  label_th            String?               @db.VarChar
  label_en            String?               @db.VarChar
  image_url           String?
  sort_order          Int                   @default(0)
  default_gift_id     Int?
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  products            products              @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_function_gifts user_function_gifts[]
  default_gift        gifts?                @relation("DefaultGift", fields: [default_gift_id], references: [id])

  @@index([product_id], map: "idx_product_functions_product")
}

model product_gifts {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String    @db.Uuid
  url        String
  filename   String?   @db.VarChar
  sort_order Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_gifts_product")
}

model product_images {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String    @db.Uuid
  url        String
  sort_order Int?      @default(0)
  alt_text   String?   @db.VarChar
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_images_product")
}

model product_presets {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String    @db.Uuid
  url        String
  filename   String    @db.VarChar
  filesize   Int?
  sort_order Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_presets_product")
}

model product_variants {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id          String    @db.Uuid
  duration_type       String    @db.VarChar
  duration_days       Int?
  label_th            String    @db.VarChar
  label_en            String    @db.VarChar
  price               Decimal   @db.Decimal(10, 2)
  is_active           Boolean?  @default(true)
  sort_order          Int?      @default(0)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  variant_type        String?   @default("normal") @db.VarChar
  premium_addon_price Decimal?  @default(0) @db.Decimal(10, 2)

  game_keys game_keys[]
  orders    orders[]
  products  products    @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_variants_product")
}

model products {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String  @unique @db.VarChar
  name_th          String  @db.VarChar
  name_en          String  @db.VarChar
  description_th   String?
  description_en   String?
  price            Decimal @db.Decimal(10, 2)
  is_active        Boolean?  @default(true)
  is_featured      Boolean?  @default(false)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
  isLower          Boolean?  @default(false)
  owner_name       String?   @db.VarChar
  owner_contact    String?   @db.VarChar
  commission_pct   Decimal?  @default(0) @db.Decimal(5, 2)
  is_consignment   Boolean?  @default(false)
  info_page_url    String?
  discord_role_id  String?   @db.VarChar
  discord_guild_id String?   @db.VarChar

  game_keys             game_keys[]
  orders                orders[]
  product_functions     product_functions[]
  product_gifts         product_gifts[]
  product_images        product_images[]
  product_presets       product_presets[]
  product_variants      product_variants[]
  product_consignments  product_consignments[]
  user_whitelist_access user_whitelist_access[]
  premium_upgrades      premium_upgrades[]

  @@index([is_consignment], map: "idx_products_consignment")
}

model product_consignments {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id    String    @db.Uuid
  owner_name    String    @db.VarChar
  owner_contact String?   @db.VarChar
  payout_share  Decimal   @db.Decimal(5, 2)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  products      products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id], map: "idx_pc_product")
}

model user_whitelist_access {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  is_premium Boolean  @default(false)
  expires_at DateTime @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  users    users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  products products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@index([user_id], map: "idx_uwa_user")
}

model premium_upgrades {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String   @db.Uuid
  user_id           String   @db.Uuid
  product_id        String   @db.Uuid
  amount            Decimal  @db.Decimal(10, 2)
  payment_method    String   @db.VarChar
  stripe_session_id String?  @db.VarChar
  upgraded_at       DateTime @default(now()) @db.Timestamptz(6)
  status            String   @default("paid") @db.VarChar
  orders   orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  users    users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  products products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([user_id],     map: "idx_pu_user")
  @@index([product_id],  map: "idx_pu_product")
  @@index([upgraded_at], map: "idx_pu_date")
}

model user_function_gifts {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String            @db.Uuid
  order_id          String            @db.Uuid
  function_id       String            @db.Uuid
  gift_id           Int
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  product_functions product_functions @relation(fields: [function_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gifts             gifts             @relation(fields: [gift_id], references: [id], onUpdate: NoAction)
  orders            orders            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, order_id, function_id])
  @@index([order_id], map: "idx_ufg_order")
  @@index([user_id],  map: "idx_ufg_user")
}

model users {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username              String                  @db.VarChar
  email                 String?                 @unique @db.VarChar
  role                  String                  @default("user") @db.VarChar
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  avatar                String?                 @db.VarChar
  accounts              accounts[]
  orders                orders[]
  user_function_gifts   user_function_gifts[]
  user_whitelist_access user_whitelist_access[]
  premium_upgrades      premium_upgrades[]
}
