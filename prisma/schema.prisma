// ─────────────────────────────────────────────────────────────────────────────
// PayPal.me email-verification flow (separate from the PayPal REST API flow).
// A standalone PM2 worker polls a Gmail inbox for PayPal "money received" emails,
// verifies DKIM/SPF + sender, parses them, and matches by exact gross USD amount.
// ─────────────────────────────────────────────────────────────────────────────

// Every PayPal email the worker touches — kept raw for debugging and so we can
// alert when PayPal changes its template (verified/parse_ok both false).
model paypal_email_log {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gmail_message_id String   @unique @db.VarChar // dedupe: never process one Gmail message twice
  received_at      DateTime @db.Timestamptz(6)
  verified         Boolean  @default(false) // DKIM=pass (paypal.com) + SPF=pass + From paypal.com
  parse_ok         Boolean  @default(false)
  error            String? // why verify/parse failed, if it did
  raw_headers      String? // includes Authentication-Results for audit
  raw_body         String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([verified, parse_ok], map: "idx_paypal_email_status")
  @@index([received_at], map: "idx_paypal_email_received")
}

// One row per parsed PayPal transaction. Doubles as the idempotency ledger
// (txn_id UNIQUE) and the admin review queue (match_status != 'matched').
model paypal_payments {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  txn_id           String    @unique @db.VarChar // PayPal transaction id — 1 txn processed once
  gmail_message_id String    @db.VarChar
  gross_amount     Decimal   @db.Decimal(10, 2) // gross the customer paid (NOT net-of-fee)
  currency         String    @db.VarChar
  sender_name      String?   @db.VarChar
  sender_email     String?   @db.VarChar
  payment_status   String    @db.VarChar // completed | pending | ... (from the email)
  match_status     String    @db.VarChar // matched | review | no_order | ambiguous | late
  review_reason    String?   @db.VarChar
  matched_order_id String?   @unique @db.Uuid
  matched_order    orders?   @relation(fields: [matched_order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  processed_at     DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([match_status], map: "idx_paypal_payments_match")
  @@index([created_at], map: "idx_paypal_payments_created")
}
